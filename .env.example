# Optional Mapbox public token. The app starts without it and explains why the map is unavailable.
MAPBOX_ACCESS_TOKEN=

# Local-only credentials. Change these before exposing the stack outside localhost.
DJANGO_SECRET_KEY=replace-this-local-secret
MINIO_ROOT_USER=local-minio
MINIO_ROOT_PASSWORD=local-minio-password

# Per-dataset upload limits and presigned URL lifetime (10 GiB, 12 hours).
UPLOAD_MAX_FILES=1000
UPLOAD_MAX_BYTES=10737418240
UPLOAD_URL_TTL_SECONDS=43200

# Worker scaling page capacity budget (4–32 task slots; defaults to 8).
LOCAL_SCALING_SLOT_BUDGET=16
    
